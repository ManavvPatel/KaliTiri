# Local server listens on port 2567; Railway sets PORT automatically.
PORT=2567
# Must be a persistent writable volume to survive redeploys.
KALITIRI_DATA_DIR=./data/tables
# Dev Vite client uses http://<your-computer-ip>:2567 automatically.
# Production client uses same origin, including HTTPS/WSS.
# VITE_COLYSEUS_URL=https://your-domain.example
